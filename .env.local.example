# Supabase (required)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Service role — required for contact form persistence, Stripe webhooks, owner moderation, and admin analytics
SUPABASE_SERVICE_ROLE_KEY=

# Canonical site URL (required in production for SEO, Stripe redirects, and auth callbacks)
NEXT_PUBLIC_SITE_URL=https://brewatlas.app

# Local development override (uncomment for local auth email/OAuth callbacks):
# NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Set to true only after Apple Sign In is enabled in Supabase + Apple Developer Console
NEXT_PUBLIC_AUTH_APPLE_ENABLED=false

# Billing provider: manual (default) | stripe
BILLING_PROVIDER=manual

# Stripe (required when BILLING_PROVIDER=stripe)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_PRICE_PREMIUM_MONTHLY=
STRIPE_PRICE_PREMIUM_YEARLY=

# Bootstrap admin (promotes this email to admin on every deploy — idempotent)
BREWATLAS_INITIAL_ADMIN_EMAIL=
# Optional recovery only: resets the EXISTING bootstrap Auth user's password on boot.
# Never creates a new user. Remove after login works again.
# BREWATLAS_INITIAL_ADMIN_PASSWORD=

# Optional: POST JSON error payloads for production alerting (Slack, PagerDuty, etc.)
# ERROR_REPORTING_WEBHOOK_URL=

# AI Coach — set provider to openai and supply OPENAI_API_KEY for LLM-backed chat
# AI_COACH_MODULE_PROVIDER=rule-based
# OPENAI_API_KEY=
# OPENAI_COACH_MODEL=gpt-4o-mini
# OPENAI_COACH_TIMEOUT_MS=60000

# See PRODUCTION_CHECKLIST.md for the full pre-deploy checklist.
