# Supabase (required)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Service role — required for Stripe webhooks, owner moderation, and admin analytics
SUPABASE_SERVICE_ROLE_KEY=

# Canonical site URL (required in production for SEO, Stripe redirects, and CSRF origin checks)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Billing provider: manual (default) | stripe
BILLING_PROVIDER=manual

# Stripe (required when BILLING_PROVIDER=stripe)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_PRICE_PREMIUM_MONTHLY=
STRIPE_PRICE_PREMIUM_YEARLY=

# Validation: lib/env.ts runs on server boot (instrumentation.ts).
# See PRODUCTION_CHECKLIST.md for the full pre-deploy checklist.
